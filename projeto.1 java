     }
        static void ListarMoto(List<Moto>moto) {

            if (moto.size()==0){
                System.out.println("nenhuma moto cadastrada ");
            }

         for (int i = 0; i<moto.size();i++){
             System.out.println("ID: "+ moto.get(i).ID);
             System.out.println("Marca: "+ moto.get(i).Marca);
             System.out.println("Modelo: "+ moto.get(i).Modelo);
             System.out.println("Ano: "+ moto.get(i).Ano);
             System.out.println("===================");

         }

    }
    static void BuscarMoto(List<Moto>moto){

         boolean encontrou  = true;

         System.out.println("Informe o ID da moto");
         int id = sc.nextInt();

        for (int i = 0; i<moto.size();i++){
            if(id == moto.get(i).ID){

                System.out.println("Marca: "+ moto.get(i).Marca);
                System.out.println("Modelo: "+ moto.get(i).Modelo);
                System.out.println("Ano: "+ moto.get(i).Ano);
            }
        }if(encontrou == false) {
            System.out.println("nenhuma moto encontrada");

}
    }
    static void CadastrarServico(List<Moto>moto, List<Servico>servico) {
        Servico s1 = new Servico();
        boolean encontrou  = false;


        System.out.println("informe o ID da moto");
        int id = sc.nextInt();
        for (int i = 0; i < moto.size(); i++) {

            if (id == moto.get(i).ID){

                 encontrou  = true;

                System.out.println("descreva o serviço");
                String ordem = sc.nextLine();

                System.out.printf(" informe o preco");
                double preco = sc.nextDouble();

                s1.MotoID = id;
                s1.servico = ordem;
                s1.Preco = preco;

                servico.add(s1);
            }
        } if (!encontrou){
            System.out.println("nenhuma moto encontrada");
        }

    }
    static void BuscarServicos(List<Moto>moto, List<Servico>sevico){
         boolean encontrou = false;

         System.out.println("informe o id da moto");
         int id = sc.nextInt();

         for(int i = 0; i< moto.size();i++){
             if (id == moto.get(i).ID){
                  encontrou = true;


                 System.out.println("Modelo: "+ moto.get(i).Modelo);
                 System.out.println("              ");
                 System.out.println("Servico: "+ sevico.get(i).servico);
                 System.out.printf("Preço: %.2f% "+sevico.get(i).Preco);
             }
         }if (!encontrou){
             System.out.println("NENHUMA MOTO ENCONTRADA");
        }
    }
    public static void main(String[] args) {
         ArrayList<Servico> servico = new ArrayList<>();
         ArrayList<Moto> moto = new ArrayList<>();

